# Orthanc Configuration
ORTHANC_NAME=ORTHANC_PROD
ORTHANC_AET=ORTHANC
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
ORTHANC_PATH=/etc/orthanc
ORTHANC_STORAGE_DIR=/var/lib/orthanc/storage
ORTHANC_DB_DIR=/var/lib/orthanc/db

# PostgreSQL Configuration
POSTGRES_DB=orthanc
POSTGRES_USER=orthanc
POSTGRES_PASSWORD=changeThisToASecurePassword
POSTGRES_PORT=5433

# Resource Limits
MALLOC_ARENA_MAX=5
MAX_CONCURRENT_JOBS=4
HTTP_THREADS_COUNT=50

# Storage Configuration
STORAGE_COMPRESSION=true
STORE_DICOM=true
MAX_STORAGE_SIZE=0
MAX_PATIENT_COUNT=0

# Security
REMOTE_ACCESS_ALLOWED=false
SSL_ENABLED=false
ORTHANC_ADMIN_USER=admin
ORTHANC_ADMIN_PASSWORD=changeThisToASecurePassword
